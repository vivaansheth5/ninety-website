# Server
PORT=8083
NODE_ENV=development
# Public origin the site is served from (used for CORS + cookie/CSP config)
APP_ORIGIN=http://localhost:8083

# Razorpay (https://dashboard.razorpay.com/app/keys)
# Test-mode keys are safe to use here. NEVER commit real keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
# Optional: only needed if you wire up the /api/payment/webhook endpoint
# in the Razorpay dashboard (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Random 32+ byte hex string used to sign CSRF tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=replace_with_a_long_random_hex_string
