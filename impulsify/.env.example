# ─── Impulsify storefront ──────────────────────────────────────────────
# Public site URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://impulsify.example

# ─── Shopify Storefront API (optional) ────────────────────────────────
# Leave these blank to run in demo mode (local catalog, demo checkout).
# Use the PUBLIC Storefront API access token from the Headless channel.
# It is designed to be exposed to browsers and can only read products and
# create carts. NEVER put an Admin API token, payment keys, UPI IDs or bank
# details in this file or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-07
